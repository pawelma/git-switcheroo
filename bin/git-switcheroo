#!/bin/sh
set -u

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  red=$(printf '\033[1;31m') green=$(printf '\033[32m') yellow=$(printf '\033[33m') cyan=$(printf '\033[36m') reset=$(printf '\033[0m')
else
  red='' green='' yellow='' cyan='' reset=''
fi

say() { printf '%s\n' "$*" >&2; }
ok() { say "${green}✓${reset} $*"; }
hop() { say "${cyan}↪${reset} $*"; }
warn() { say "${yellow}⚠${reset} $*"; }
fail() { say "${red}✗ $*${reset}"; }

underlying_command() {
  case "$1" in
    checkout | switch) echo "$1" ;;
    sr) echo switch ;;
    *)
      case "$(git config --get "alias.$1" 2>/dev/null)" in
        checkout) echo checkout ;;
        switch) echo switch ;;
      esac
      ;;
  esac
}

branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" && return 0
  [ "$(git for-each-ref --format='%(refname:strip=3)' refs/remotes | grep -cFx -- "$1")" -eq 1 ]
}

current_ref() {
  git symbolic-ref --short -q HEAD || git rev-parse --short HEAD 2>/dev/null
}

[ $# -ge 1 ] || { say "usage: git-switcheroo <command> [args...]"; exit 64; }
cmd=$1
shift
underlying=$(underlying_command "$cmd")
[ -n "$underlying" ] || exec git "$cmd" "$@"

if [ $# -ne 1 ] || ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exec git "$underlying" "$@"
fi

branch=$1
case "$branch" in -*) exec git "$underlying" "$branch" ;; esac
branch_exists "$branch" || exec git "$underlying" "$branch"

if [ "$(git symbolic-ref --short -q HEAD)" = "$branch" ]; then
  ok "already on $branch"
  exit 0
fi

before=$(current_ref)
git "$underlying" "$branch"
rc=$?
if [ "$rc" -ne 0 ]; then
  fail "checkout failed — still on $before"
  exit "$rc"
fi

after=$(git symbolic-ref --short -q HEAD)
if [ "$after" != "$branch" ]; then
  fail "expected $branch, HEAD is ${after:-detached at $(git rev-parse --short HEAD)}"
  exit 1
fi
ok "on $branch ($(git log -1 --format='%h %s'))"
