#!/bin/sh
set -u

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  red=$(printf '\033[1;31m') green=$(printf '\033[32m') yellow=$(printf '\033[33m') cyan=$(printf '\033[36m') reset=$(printf '\033[0m')
else
  red='' green='' yellow='' cyan='' reset=''
fi

say() { printf '%s\n' "$*" >&2; }
ok() { say "${green}✓${reset} $*"; }
hop() { say "${cyan}↪${reset} $*"; }
warn() { say "${yellow}⚠${reset} $*"; }
fail() { say "${red}✗ $*${reset}"; }

underlying_command() {
  case "$1" in
    checkout | switch) echo "$1" ;;
    sr) echo switch ;;
    *)
      case "$(git config --get "alias.$1" 2>/dev/null)" in
        checkout) echo checkout ;;
        switch) echo switch ;;
      esac
      ;;
  esac
}

branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" && return 0
  [ "$(git for-each-ref --format='%(refname:strip=3)' refs/remotes | grep -cFx -- "$1")" -eq 1 ]
}

current_ref() {
  git symbolic-ref --short -q HEAD || git rev-parse --short HEAD 2>/dev/null
}

worktree_holding() {
  git worktree list --porcelain | awk -v ref="refs/heads/$1" '
    /^worktree / { path = substr($0, 10); found = 0; locked = "unlocked"; reason = "" }
    $0 == "branch " ref { found = 1 }
    /^locked/ { locked = "locked"; reason = substr($0, 8) }
    /^$/ && found && !done { print path; print locked; print reason; done = 1 }
    END { if (found && !done) { print path; print locked; print reason } }
  '
}

[ $# -ge 1 ] || { say "usage: git-switcheroo <command> [args...]"; exit 64; }
cmd=$1
shift
underlying=$(underlying_command "$cmd")
[ -n "$underlying" ] || exec git "$cmd" "$@"

if [ $# -ne 1 ] || ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exec git "$underlying" "$@"
fi

branch=$1
if [ "$branch" = "-" ]; then
  previous=$(git rev-parse --symbolic-full-name '@{-1}' 2>/dev/null)
  case "$previous" in
    refs/heads/*) branch=${previous#refs/heads/} ;;
    *) exec git "$underlying" - ;;
  esac
fi
case "$branch" in -*) exec git "$underlying" "$branch" ;; esac
branch_exists "$branch" || exec git "$underlying" "$branch"

if [ "$(git symbolic-ref --short -q HEAD)" = "$branch" ]; then
  ok "already on $branch"
  exit 0
fi

holder=$(worktree_holding "$branch")
if [ -n "$holder" ]; then
  wt_path=$(printf '%s\n' "$holder" | sed -n 1p)
  wt_lock=$(printf '%s\n' "$holder" | sed -n 2p)
  wt_reason=$(printf '%s\n' "$holder" | sed -n 3p)

  if [ -d "$wt_path" ]; then
    if [ -z "${SWITCHEROO_CD_FILE:-}" ]; then
      fail "$branch is checked out at $wt_path — cd there"
      exit 2
    fi
    prefix=${GIT_PREFIX:-$(git rev-parse --show-prefix)}
    destination=$wt_path
    if [ -n "$prefix" ] && [ -d "$wt_path/$prefix" ]; then
      destination=$wt_path/${prefix%/}
    fi
    if ! printf '%s\n' "$destination" 2>/dev/null >"$SWITCHEROO_CD_FILE"; then
      fail "could not hand the worktree path to your shell — cd $wt_path"
      exit 1
    fi
    hop "$branch lives in $wt_path — hopping"
    say "  $(git -C "$wt_path" log -1 --format='%h %s')"
    exit 0
  fi

  if [ "$wt_lock" = locked ]; then
    fail "$branch held by locked worktree $wt_path${wt_reason:+ ($wt_reason)} — git worktree unlock $wt_path first"
    exit 1
  fi
  warn "worktree $wt_path for $branch is gone — removing stale entry"
  git worktree remove "$wt_path" || { fail "could not remove stale worktree $wt_path"; exit 1; }
fi

before=$(current_ref)
git "$underlying" "$branch"
rc=$?
if [ "$rc" -ne 0 ]; then
  fail "checkout failed — still on $before"
  exit "$rc"
fi

after=$(git symbolic-ref --short -q HEAD)
if [ "$after" != "$branch" ]; then
  fail "expected $branch, HEAD is ${after:-detached at $(git rev-parse --short HEAD)}"
  exit 1
fi
ok "on $branch ($(git log -1 --format='%h %s'))"
