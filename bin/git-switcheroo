#!/bin/sh
set -u

# git exports GIT_DIR to ! aliases run in a linked worktree; it would override every git -C
[ -n "${GIT_WORK_TREE:-}" ] || unset GIT_DIR

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  red=$(printf '\033[1;31m') green=$(printf '\033[32m') yellow=$(printf '\033[33m') cyan=$(printf '\033[36m') reset=$(printf '\033[0m')
else
  red='' green='' yellow='' cyan='' reset=''
fi

say() { printf '%s\n' "$*" >&2; }
ok() { say "${green}✓${reset} $*"; }
hop() { say "${cyan}↪${reset} $*"; }
warn() { say "${yellow}⚠${reset} $*"; }
fail() { say "${red}✗ $*${reset}"; }

underlying_command() {
  case "$1" in
    checkout | switch) echo "$1" ;;
    sr) echo switch ;;
    *)
      case "$(git config --get "alias.$1" 2>/dev/null)" in
        checkout) echo checkout ;;
        switch) echo switch ;;
      esac
      ;;
  esac
}

branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" && return 0
  [ "$(git for-each-ref --format='%(refname:strip=3)' refs/remotes | grep -cFx -- "$1")" -eq 1 ]
}

current_ref() {
  git symbolic-ref --short -q HEAD || git rev-parse --short HEAD 2>/dev/null
}

worktree_holding() {
  git worktree list --porcelain | awk -v ref="refs/heads/$1" '
    /^worktree / { path = substr($0, 10); found = 0; locked = "unlocked"; reason = "" }
    $0 == "branch " ref { found = 1 }
    /^locked/ { locked = "locked"; reason = substr($0, 8) }
    /^$/ && found && !done { print path; print locked; print reason; done = 1 }
    END { if (found && !done) { print path; print locked; print reason } }
  '
}

default_branch() {
  origin_head=$(git symbolic-ref --short -q refs/remotes/origin/HEAD) &&
    git show-ref --verify --quiet "refs/remotes/$origin_head" && { echo "${origin_head#origin/}"; return; }
  for candidate in main master; do
    git show-ref --verify --quiet "refs/heads/$candidate" && { echo "$candidate"; return; }
  done
}

main_worktree() {
  git worktree list --porcelain | awk '
    NR == 1 { path = substr($0, 10) }
    /^$/ { exit }
    $0 == "bare" { bare = 1 }
    END { if (!bare) print path }
  '
}

same_dir() {
  [ "$(cd "$1" && pwd -P)" = "$(cd "$2" && pwd -P)" ]
}

hand_to_shell() {
  if [ -z "${SWITCHEROO_CD_FILE:-}" ]; then
    fail "$branch is checked out at $1 — cd there"
    exit 2
  fi
  prefix=${GIT_PREFIX:-$(git rev-parse --show-prefix)}
  destination=$1
  if [ -n "$prefix" ] && [ -d "$1/$prefix" ]; then
    destination=$1/${prefix%/}
  fi
  if ! printf '%s\n' "$destination" 2>/dev/null >"$SWITCHEROO_CD_FILE"; then
    fail "could not hand the worktree path to your shell — cd $1"
    exit 1
  fi
}

restore_detached() {
  [ -n "$detached_from" ] || return 0
  if git -C "$detached_from" checkout -q "$branch"; then
    say "  $branch put back in $detached_from"
  else
    fail "could not put $branch back in $detached_from — it is still detached; git -C $detached_from checkout $branch"
  fi
}

[ $# -ge 1 ] || { say "usage: git-switcheroo <command> [args...]"; exit 64; }
cmd=$1
shift
underlying=$(underlying_command "$cmd")
[ -n "$underlying" ] || exec git "$cmd" "$@"

if [ $# -ne 1 ] || ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exec git "$underlying" "$@"
fi

branch=$1
if [ "$branch" = "-" ]; then
  previous=$(git rev-parse --symbolic-full-name '@{-1}' 2>/dev/null)
  case "$previous" in
    refs/heads/*) branch=${previous#refs/heads/} ;;
    *) exec git "$underlying" - ;;
  esac
fi
case "$branch" in -*) exec git "$underlying" "$branch" ;; esac
branch_exists "$branch" || exec git "$underlying" "$branch"

pin_dir=''
if [ "$(git config --type=bool --get switcheroo.pinDefaultBranch 2>/dev/null || echo true)" = true ] &&
  [ "$branch" = "$(default_branch)" ]; then
  pin_dir=$(main_worktree)
fi
target_dir=.
if [ -n "$pin_dir" ] && ! same_dir "$(git rev-parse --show-toplevel)" "$pin_dir"; then
  target_dir=$pin_dir
fi

if [ "$target_dir" = . ] && [ "$(git symbolic-ref --short -q HEAD)" = "$branch" ]; then
  ok "already on $branch"
  exit 0
fi

detached_from=''
holder=$(worktree_holding "$branch")
if [ -n "$holder" ]; then
  wt_path=$(printf '%s\n' "$holder" | sed -n 1p)
  wt_lock=$(printf '%s\n' "$holder" | sed -n 2p)
  wt_reason=$(printf '%s\n' "$holder" | sed -n 3p)

  if [ -d "$wt_path" ] && [ -n "$pin_dir" ] && ! same_dir "$wt_path" "$pin_dir"; then
    git -C "$wt_path" checkout -q --detach || { fail "could not detach $branch in $wt_path"; exit 1; }
    warn "detached $branch in $wt_path — it belongs in $pin_dir"
    detached_from=$wt_path
  elif [ -d "$wt_path" ]; then
    hand_to_shell "$wt_path"
    hop "$branch lives in $wt_path — hopping"
    say "  $(git -C "$wt_path" log -1 --format='%h %s')"
    exit 0
  elif [ "$wt_lock" = locked ]; then
    fail "$branch held by locked worktree $wt_path${wt_reason:+ ($wt_reason)} — git worktree unlock $wt_path first"
    exit 1
  else
    warn "worktree $wt_path for $branch is gone — removing stale entry"
    git worktree remove "$wt_path" || { fail "could not remove stale worktree $wt_path"; exit 1; }
  fi
fi

if [ "$target_dir" = . ]; then
  where=''
else
  where=" in $target_dir"
fi
before=$(cd "$target_dir" && current_ref)
git -C "$target_dir" "$underlying" "$branch"
rc=$?
if [ "$rc" -ne 0 ]; then
  restore_detached
  fail "checkout failed$where — still on $before"
  exit "$rc"
fi

after=$(git -C "$target_dir" symbolic-ref --short -q HEAD)
if [ "$after" != "$branch" ]; then
  restore_detached
  fail "expected $branch$where, HEAD is ${after:-detached at $(git -C "$target_dir" rev-parse --short HEAD)}"
  exit 1
fi
ok "on $branch$where ($(git -C "$target_dir" log -1 --format='%h %s'))"
[ "$target_dir" = . ] || hand_to_shell "$target_dir"
